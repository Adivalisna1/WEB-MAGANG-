# ============================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya
# cp .env.example .env
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword_ganti_ini
MYSQL_DATABASE=web_laporan
MYSQL_USER=laporan_user
MYSQL_PASSWORD=laporan_pass_ganti_ini
MYSQL_PORT=3306

# --- phpMyAdmin ---
PMA_PORT=8080

# --- Aplikasi Backend (nanti dipakai) ---
APP_PORT=5000
JWT_SECRET=jwt_secret_ganti_ini_panjang_random
JWT_EXPIRES_IN=8h

# --- Aplikasi Frontend (nanti dipakai) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
